# Production Docker Environment Variables
PROJECT_NAME="Enterprise IT Support & Incident Resolver"
VERSION="1.0.0"
ENVIRONMENT="production"

# PostgreSQL Configuration for Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=it_resolver_db
DATABASE_URL=postgresql://postgres:postgres@db:5432/it_resolver_db

# Security Settings
SECRET_KEY=production_secure_jwt_secret_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
