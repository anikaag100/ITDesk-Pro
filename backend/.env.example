# Application Settings
PROJECT_NAME="Enterprise IT Support & Incident Resolver"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration
# Fallback to local SQLite if DATABASE_URL is not set or empty
DATABASE_URL="sqlite:///./it_resolver.db"

# To use PostgreSQL, uncomment and configure below:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/it_resolver_db"

# Security Settings
SECRET_KEY="change_this_to_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
